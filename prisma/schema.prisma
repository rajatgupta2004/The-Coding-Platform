generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  firstName       String
  lastName        String?
  email           String    @unique
  phone           String
  roleId          Int
  permissionType  String
  createdDate     DateTime  @default(now())
  updatedDate     DateTime  @updatedAt
  userId          String    @unique
  // Relations
  role            Role      @relation(fields: [roleId], references: [id])
  college         College?   // 👈 One-to-one inverse relation (optional if College may not exist yet)
}

model College {
  collegeId           Int       @id @default(autoincrement())
  collegeName         String
  email               String    @unique
  address             String
  phone               String
  pinCode             String
  subscriptionId      Int?
  userId              Int       @unique // 👈 Ensures one-to-one
  roleId              Int
  permissionId        Int
  permissionScopeId   Int
  createdDate         DateTime  @default(now())
  createdBy           Int
  updatedDate         DateTime  @updatedAt
  updatedBy            Int

  // Relations
  user                User       @relation(fields: [userId], references: [id])
  role                Role       @relation(fields: [roleId], references: [id])
  permission          Permission @relation(fields: [permissionId], references: [id])
  permissionScope     PermissionScope @relation(fields: [permissionScopeId], references: [id])
}


model Role {
  id                 Int      @id @default(autoincrement())
  permissionId       Int
  createdDate        DateTime @default(now())
  updatedDate        DateTime @updatedAt
  createdById        Int
  updatedById        Int
  active             Boolean
  permissionScopeId  Int

  // Relations
  permission         Permission @relation(fields: [permissionId], references: [id])
  permissionScope    PermissionScope @relation(fields: [permissionScopeId], references: [id])
  users              User[]
  colleges           College[]
}

model Permission {
  id                Int       @id @default(autoincrement())
  permissionType    String
  permissionName    String
  permissionScope   String
  active            Boolean
  createdBy         Int
  createdDate       DateTime  @default(now())
  updatedBy         Int
  updatedDate       DateTime  @updatedAt

  // Relations
  roles             Role[]
  colleges          College[]
}
 
model PermissionScope {
  id                Int       @id @default(autoincrement())
  permissionScopeName String
  createdDate       DateTime  @default(now())
  createdBy         Int
  updatedDate       DateTime  @updatedAt
  updatedBy         Int
  active            Boolean
  permissionId      Int?

  // Relations
  roles             Role[]
  colleges          College[]
}
